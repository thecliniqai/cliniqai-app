# Pinned tools for the FT-02 backup and restore drill (V2-04 04-05a, ruling R-31; PO confirms in 04-P15).
# Sourced by ops/bin/*.sh, ops/backup/backup.sh and ops/restore-drill/run.sh (locally, nightly and in backup.yml).
# KEY=value lines only (no quotes, no expansion). Upgrade: pick a release at least 7 days old, read the new digest from
# the publisher (age: `gh api repos/FiloSottile/age/releases/tags/<tag>` assets[].digest; images: `docker buildx
# imagetools inspect <image>:<tag>`), change the line and record the tool
# output in .planning/phases/04-jobs-reliability/evidence/pins.json.

# age v1.3.2 (published 2026-08-29), release tarballs per platform: SHA-256 of age-v1.3.2-<os>-<arch>.tar.gz.
AGE_VERSION=1.3.2
AGE_SHA256_DARWIN_ARM64=e2020b073c44f692685a24d6abc378817eb81ffaaf49fd0531ef8565f767f2f5
AGE_SHA256_DARWIN_AMD64=1d1e4bc66e1427edad7739ae7616157de0e79db8b6d2a1497d7d9925fb06a539
AGE_SHA256_LINUX_AMD64=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
AGE_SHA256_LINUX_ARM64=6b8dc4333c53a5a57c9e5834e3a48f92605d7154014cd07269ff3327db5d37f4

# psql 17 client (host psql is 14, research pitfall 12). Docker official image, multi-arch index digest (tag pushed
# 2026-11-06).
POSTGRES_IMAGE=postgres:17.11@sha256:ff87138949ad9a46f32ff23bd6852b52ce024a13dffe9b4087be98292cdd3b4f

# AWS CLI v2 for every S3 call (R2 target, Supabase Storage source, local stand-in; no AWS SDK in the repo). Official image, multi-arch digest (2026-10-30).
AWS_CLI_IMAGE=amazon/aws-cli:2.39.3@sha256:d557b3524475d70dd3104cf44d96568ee3188897b73a6ece2b37aa50e1af362f

# Supabase CLI: the repo pin (package.json devDependencies.supabase); `db dump` carries Supabase's role/schema rules.
SUPABASE_CLI_VERSION=2.120.0
