  {
    "template_name": "appointment_booked",
    "language": "en",
    "category": "UTILITY",
    "button_url": false,
    "description": "Triggered when an appointment is booked for a patient (Event #1). Includes interactive quick reply buttons for Confirm, Cancel, and Reschedule.",
    "components": [
      {
        "type": "HEADER",
        "format": "TEXT",
        "text": "Appointment Confirmation"
      },
      {
        "type": "BODY",
        "text": "Hello {{1}}, your appointment with Dr. {{2}} at {{3}} is confirmed for {{4}}. Please arrive 10 minutes prior to your scheduled time.",
        "example": {
          "body_text": [
            [
              "Rahul Sharma",
              "Aditi Rao",
              "Pune Care Clinic",
              "Wednesday, Oct 28 at 10:30 AM"
            ]
          ]
        }
      },
      {
        "type": "FOOTER",
        "text": "ClinicQ Health Services"
      },
      {
        "type": "BUTTONS",
        "buttons": [
          {
            "type": "QUICK_REPLY",
            "text": "Confirm"
          },
          {
            "type": "QUICK_REPLY",
            "text": "Cancel"
          },
          {
            "type": "QUICK_REPLY",
            "text": "Reschedule"
          }
        ]
      }
    ]
  },
