# Test lane environment (V2-01a, P0-10). Committed on purpose: LOCAL STACK VALUES ONLY, no keys.
# Vitest never reads .env. A variable already exported in the shell wins over this file, and is then checked by
# tests/setup/test-env.ts, which refuses to run if any value points at a hosted service, a provider is not in
# offline mode, or a real-credential variable is set.
# The local anon and service-role keys are not stored here: the loader reads them from `npx supabase status`
# (the public "supabase-demo" keys of the developer's own 127.0.0.1 stack) and rejects any other issuer.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Offline providers only.
MESSAGING_PROVIDER=dev
AI_PROVIDER=mock
AI_API_KEY=test-ai-key-not-real
STORAGE_PROVIDER=supabase

# Placeholder secrets required by code paths under test (not real credentials).
MSG91_AUTH_KEY=test-msg91-auth-key-not-real
MSG91_WEBHOOK_SECRET=testsecret
MSG91_INTEGRATED_NUMBER=910000000000
CRON_SECRET=test-cron-secret-not-real

# Local Mailpit (auth emails), used by the AUTH-00 spike.
MAILPIT_URL=http://127.0.0.1:54324
