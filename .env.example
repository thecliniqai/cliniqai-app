# ClinicQ Environment Configuration
# Never commit real credentials to version control (AGENTS.md §32)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-access-token

# Public Application URL (production: https://app.thecliniqai.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MSG91 Cloud Communication
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_INTEGRATED_NUMBER=91XXXXXXXXXX
MSG91_SENDER_ID=91XXXXXXXXXX
MSG91_WEBHOOK_SECRET=your_msg91_webhook_secret
MESSAGING_PROVIDER=msg91

# CliniQ AI Gateway Configuration (OpenAI, Groq, Gemini, OpenRouter, or local Ollama)
AI_PROVIDER=openai
AI_API_KEY=your_openai_or_compatible_api_key
AI_MODEL_NAME=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

