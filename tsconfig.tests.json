{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "types": ["node", "vitest/globals", "vite/client"]
  },
  "include": [
    "next-env.d.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
