{
  "name": "clinicos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "inventory": "tsx scripts/inventory-server-actions.ts",
    "db:types": "supabase gen types typescript --local --schema public > types/database.ts && prettier --log-level warn --write types/database.ts",
    "db:drift:local": "node scripts/ci/local-drift.mjs",
    "ci:ai-l1": "node scripts/ci/ai-l1-greps.mjs",
    "ci:audit": "node scripts/ci/audit-gate.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "test:db": "supabase start -x studio,edge-runtime,logflare,vector,imgproxy,supavisor && vitest run",
    "test:watch": "vitest",
    "test:ai": "vitest run tests/ai tests/security/ai-rbac.spec.ts tests/security/pii-scrubber.spec.ts",
    "test:e2e": "npm run e2e:pr",
    "e2e:build": "tsx tests/e2e/support/build.ts",
    "e2e:pr": "playwright test --project=desktop-chrome --project=pixel-7 --project=iphone-15",
    "e2e:nightly": "playwright test --project=iphone-se-3 --project=galaxy-tab-s4 --project=galaxy-tab-s4-landscape --project=android-tablet-800 --project=ipad-gen7 --project=ipad-gen7-landscape --project=ipad-mini-744",
    "e2e:baseline": "playwright test tests/e2e/m0 --project=desktop-chrome --project=vp-360 --project=vp-768 --project=vp-1280 --project=m0-axe-desktop-chrome --project=m0-axe-pixel-7 --project=m0-axe-iphone-15 && node scripts/m0-baseline-report.mjs",
    "seed:local": "tsx scripts/seed-local-dev.ts",
    "seed:cdci": "npx tsx --env-file=.env scripts/seed-cdci.ts",
    "seed:cdci:test": "npx tsx --env-file=.env scripts/seed-cdci-test-fixture.ts",
    "seed:diagnoses": "npx tsx --env-file=.env scripts/seed-opd-diagnoses.ts",
    "msg91:sync-templates": "npx tsx --env-file=.env scripts/msg91-sync-templates.ts",
    "msg91:test-send": "npx tsx --env-file=.env scripts/msg91-test-send.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/openai": "^1.3.24",
    "@ai-sdk/react": "^1.2.12",
    "@aws-sdk/client-sesv2": "3.1155.0",
    "@date-fns/tz": "1.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "ai": "^4.3.19",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "standardwebhooks": "1.1.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.0.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.22.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "smol-toml": "1.9.1",
    "supabase": "2.120.0",
    "tailwindcss": "^4.0.12",
    "tsx": "4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
